  },
  "apple": {
    "minimum_ios": "17.0",
    "build_host": "macos",
    "required_sdks": ["iphoneos", "iphonesimulator"],
    "architectures": {
      "iphoneos": ["arm64"],
      "iphonesimulator": ["arm64"]
    },
    "build_args": ["-Demit-lib-vt=true", "-Demit-xcframework=true", "-Doptimize=ReleaseFast"],
    "output": "app/modules/zen-terminal-vt/libs/apple/ghostty-vt.xcframework",
    "checksums": "app/modules/zen-terminal-vt/libs/apple/SHA256SUMS",
    "manifest": "app/modules/zen-terminal-vt/libs/apple/build-manifest.json",
    "status": "bridge_source_pending_macos_acceptance",
    "note": "The podspec mandatory-links this pinned XCFramework and the iOS bridge source implements the JS handle contract. Capability remains gated until macOS compile/link and device acceptance are recorded."
  },
  "abis": [
    {
      "android_abi": "arm64-v8a",
      "zig_target": "aarch64-linux-android",
      "elf_machine": "AArch64",
      "elf_machine_code": 183,
      "role": "device_release",
      "required_for_sideload": true
    },
    {
      "android_abi": "x86_64",
      "zig_target": "x86_64-linux-android",
      "elf_machine": "Advanced Micro Devices X86-64",
      "elf_machine_code": 62,
      "role": "emulator",
      "required_for_sideload": false
