    "headers_dir": "app/modules/zen-terminal-vt/android/src/main/cpp/ghostty",
    "checksums_filename": "SHA256SUMS",
    "manifest_filename": "build-manifest.json"
  },
  "release_apk": {
    "react_native_architectures": "arm64-v8a",
    "script": "scripts/android-release-apk.sh",
    "notice_apk_path": "assets/notices/GHOSTTY-MIT.txt",
    "notice_source": "app/assets/notices/GHOSTTY-MIT.txt",
    "note": "Sideload beta ships arm64-v8a only. x86_64 is for emulator/dev builds. Notice is packaged via Expo plugin withZenAndroidRelease into android assets (verified by scripts/verify-apk-notice.sh)."
  },
  "signing": {
    "env_vars": [
      "ZEN_ANDROID_KEYSTORE",
      "ZEN_ANDROID_KEYSTORE_PASSWORD",
      "ZEN_ANDROID_KEY_ALIAS",
      "ZEN_ANDROID_KEY_PASSWORD"
    ],
    "mechanism": "Gradle System.getenv via withZenAndroidRelease plugin; never commit secrets"
  }
