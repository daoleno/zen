{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:debug": "expo run:android --variant debug",
    "android:release": "expo run:android --variant release",
    "build:apk": "cd android && env NODE_ENV=production ./gradlew --no-daemon --build-cache assembleRelease -PreactNativeArchitectures=arm64-v8a -Pexpo.useLegacyPackaging=true && ln -f app/build/outputs/apk/release/app-release.apk app/build/outputs/apk/release/app-release-arm64.apk && echo '\n✅ APK: android/app/build/outputs/apk/release/app-release-arm64.apk'",
    "build:apk:arm64": "bun run build:apk",
    "build:apk:universal": "cd android && ./gradlew --no-daemon assembleRelease && echo '\n✅ APK: android/app/build/outputs/apk/release/app-release.apk'",
    "build:apk:debug": "cd android && ./gradlew --no-daemon assembleDebug && echo '\n✅ APK: android/app/build/outputs/apk/debug/app-debug.apk'",
    "serve:apk": "cd android/app/build/outputs/apk/release && python3 -m http.server 8899",
    "serve:apk:arm64": "cd android/app/build/outputs/apk/release && python3 -m http.server 8899",
    "serve:apk:debug": "cd android/app/build/outputs/apk/debug && python3 -m http.server 8899"
  },
  "dependencies": {
    "@expo/ui": "~57.0.4",
    "@expo/vector-icons": "^15.0.2",
    "@lobehub/icons-rn": "^2.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.1",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-drawer-layout": "4.2.4",
    "react-native-enriched-markdown": "0.5.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-pdf-renderer": "2.3.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "4.3.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "remend": "1.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
